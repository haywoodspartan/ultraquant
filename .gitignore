# Python
__pycache__/
*.pyc
*.pyo

# Generated model homes - rebuilt in ~6s by the redeploy script; the library
# ships as .uql artifacts, not as source. dispatch.json inside them is
# machine-specific learned experience.
uq_home/
uq_home_demo/
uq_probe/
uq_gui_home*/
artchive_store/
forged/

# Portable-mode settings. ultraquant/config.py writes here when the file
# already exists beside the checkout, so a working copy keeps its own
# preferences - which are machine-specific (paths, device choice, RAM budget)
# and never belong to anyone else.
ultraquant.json

# Native build intermediates (the prebuilt DLLs in ultraquant/native/_bin ARE
# tracked - they are the optional accelerators the quick start references).
native/_build/
*.obj
*.pdb

# The native cognitive tier builds its own executables. These are NOT tracked:
# unlike the accelerator DLLs, nothing degrades without them - the parity gates
# skip, and the Python tier answers every question by itself, which is the
# whole point of it defining the semantics.
native/uq/_build/
